<!--
  Demo launcher for the public backpack_3d bag with explicit static TFs.
  This avoids relying on robot_state_publisher for the demo-only backpack URDF.
-->
<launch>
  <arg name="bag_filename" />

  <param name="/use_sim_time" value="true" />

  <node name="base_to_imu_link" pkg="tf2_ros" type="static_transform_publisher"
      args="0 0 0 0 0 3.1416 base_link imu_link" />

  <node name="base_to_horizontal_vlp16_link" pkg="tf2_ros" type="static_transform_publisher"
      args="0.01 0 0.19 3.1416 -0.1745 0 base_link horizontal_vlp16_link" />

  <node name="base_to_vertical_vlp16_link" pkg="tf2_ros" type="static_transform_publisher"
      args="0.19 0 0.04 0 1.3963 0 base_link vertical_vlp16_link" />

  <node name="cartographer_node" pkg="cartographer_ros"
      type="cartographer_node" args="
          -configuration_directory $(find cartographer_ros)/configuration_files
          -configuration_basename backpack_3d.lua"
      output="screen">
    <remap from="points2_1" to="horizontal_laser_3d" />
    <remap from="points2_2" to="vertical_laser_3d" />
  </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node" args="-resolution 0.05" />

  <node name="rviz" pkg="rviz" type="rviz" required="true"
      args="-d $(find cartographer_ros)/configuration_files/demo_3d.rviz" />

  <node name="playbag" pkg="rosbag" type="play"
      args="--clock $(arg bag_filename)" />
</launch>
